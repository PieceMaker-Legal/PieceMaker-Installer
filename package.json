{
  "name": "PieceMaker",
  "version": "1.0.0",
  "description": "PieceMaker",
  "main": "electron/main.js",
  "author": "Gonzagues - PieceMaker",
  "license": "MIT",
  "bin": {
    "piecemaker": "installer/bin/piecemaker.mjs"
  },
  "scripts": {
    "install:piecemaker": "node installer/bin/piecemaker.mjs",
    "check": "node installer/bin/piecemaker.mjs --check",
    "server": "node websocket-server/server.cjs",
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder -mw",
    "build:win-signed": "electron-builder --win --config.win.certificateFile=piecemaker-cert.pfx --config.win.certificatePassword=piecemaker",
    "build:mac-signed": "electron-builder --mac --config.mac.identity=\"PieceMaker Developer Certificate\"",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "babel-loader": "^9.1.3",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "dotenv": "^17.2.3",
    "electron-store": "^8.2.0",
    "eslint-plugin-office-addins": "^4.0.3",
    "express": "^4.18.0",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "office-addin-cli": "^2.0.3",
    "office-addin-debugging": "^6.0.3",
    "office-addin-dev-certs": "^2.0.3",
    "office-addin-lint": "^3.0.3",
    "office-addin-manifest": "^2.0.3",
    "office-addin-prettier-config": "^2.0.1",
    "ollama": "^0.6.3",
    "os-browserify": "^0.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.449",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "typescript": "^5.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "5.1.0",
    "ws": "^8.14.0",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.0"
  },
  "build": {
    "appId": "com.piecemaker.wordassistant",
    "productName": "PieceMaker Word Assistant",
    "directories": {
      "output": "dist",
      "buildResources": "electron/build"
    },
    "files": [
      "**/*",
      "!**/*.map",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "asarUnpack": [
      "mcp-server/**/*",
      "taskpane/**/*",
      "websocket-server/**/*",
      "certificates/**/*",
      "output/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publisherName": "PieceMaker",
      "certificateFile": "piecemaker-cert.pfx",
      "certificatePassword": "droit",
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PieceMaker",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "identity": "PieceMaker Developer Certificate",
      "type": "distribution"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "background": "build/background.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "snap"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    }
  }
}
