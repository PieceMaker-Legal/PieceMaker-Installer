# Valeurs locales du volet Word PieceMaker.
#
# ATTENTION : contrairement au projet amont, ces variables ne vivent PAS dans
# taskpane/.env — elles sont lues depuis le fichier `.env` de la RACINE du
# dépôt, chargé par dotenv dans websocket-server/server.cjs. Ce fichier est un
# aide-mémoire ; `bash taskpane/scripts/dev.sh` ajoute les clés manquantes au
# .env racine sans jamais écraser celles qui s'y trouvent déjà.
#
# Le volet PieceMaker est en fichiers statiques (pas de bundler) : aucune de ces
# valeurs n'est compilée dans le code, elles sont lues à l'exécution côté serveur.

# Port HTTPS du serveur PieceMaker. Le manifeste (taskpane/manifest.xml) est
# figé sur https://localhost:43098 : changer ce port impose de réécrire le
# manifeste (URLs + AppDomain) et de réenregistrer l'add-in.
PORT=43098

# Identité de l'add-in, lue par websocket-server/lib/docx-autoopen.cjs pour
# écrire la référence webextension dans le .docx. DOIT rester identique au
# <Id> et au <Version> de taskpane/manifest.xml, sinon l'auto-ouverture du
# volet ne résout plus.
PIECEMAKER_ADDIN_ID=12345678-1234-1234-1234-123456789abc
PIECEMAKER_ADDIN_VERSION=1.0.0.0

# Type d'enregistrement inscrit dans la référence webextension. Les valeurs par
# défaut (developer / Registry) sont celles qui fonctionnent sur macOS ET
# Windows avec un add-in enregistré en mode développeur ; ne les changer qu'en
# connaissance de cause.
PIECEMAKER_ADDIN_STORE=developer
PIECEMAKER_ADDIN_STORE_TYPE=Registry

# Uniquement pour `npm run build --prefix taskpane` : origine HTTPS publique de
# déploiement du volet. Le manifeste versionné reste sur localhost ; la version
# réécrite est produite dans taskpane/dist/.
# PIECEMAKER_ADDIN_PUBLIC_URL=https://volet.example.com
