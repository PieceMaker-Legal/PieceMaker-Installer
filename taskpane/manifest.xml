<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="TaskPaneApp">

  <!-- L'<Id> est l'identité de l'add-in sur le poste. Il est référencé par
       websocket-server/lib/docx-autoopen.cjs (constante ADDIN_ID) pour écrire
       la partie webextension du .docx, et sert de nom de fichier dans le
       dossier de sideload macOS. NE JAMAIS le changer : tout document déjà
       préparé cesserait d'ouvrir le volet automatiquement.
       <Version> doit de même rester alignée sur ADDIN_VERSION. -->
  <Id>12345678-1234-1234-1234-123456789abc</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>PieceMaker</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="PieceMaker" />
  <Description DefaultValue="AI Legal Tool" />

  <!-- Toutes les URLs pointent sur le serveur PieceMaker (websocket-server/
       server.cjs), qui sert taskpane/ en statique en HTTPS sur le port 43098.
       Il n'y a pas de dev-server webpack : ce sont les fichiers du dépôt qui
       sont servis tels quels. `npm run build` produit une variante de ce
       manifeste avec une origine publique dans taskpane/dist/. -->
  <IconUrl DefaultValue="https://localhost:43098/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:43098/assets/icon-64.png" />
  <SupportUrl DefaultValue="https://piecemaker.fr/support" />

  <AppDomains>
    <AppDomain>https://localhost:43098</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="SharedRuntime" MinVersion="1.1" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:43098/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Document">

        <Runtimes>
          <Runtime resid="Taskpane.Url" lifetime="long" />
        </Runtimes>

        <DesktopFormFactor>
          <GetStarted>
            <Title resid="GetStarted.Title" />
            <Description resid="GetStarted.Description" />
            <LearnMoreUrl resid="GetStarted.LearnMoreUrl" />
          </GetStarted>

          <FunctionFile resid="Commands.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="CommandsGroup">
                <Label resid="CommandsGroup.Label" />
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16" />
                  <bt:Image size="32" resid="Icon.32x32" />
                  <bt:Image size="80" resid="Icon.80x80" />
                </Icon>

                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label" />
                  <Supertip>
                    <Title resid="TaskpaneButton.Label" />
                    <Description resid="TaskpaneButton.Tooltip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16" />
                    <bt:Image size="32" resid="Icon.32x32" />
                    <bt:Image size="80" resid="Icon.80x80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>Office.AutoShowTaskpaneWithDocument</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url" />
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:43098/assets/icon-16.png" />
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:43098/assets/icon-32.png" />
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:43098/assets/icon-80.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="GetStarted.LearnMoreUrl" DefaultValue="https://piecemaker.fr" />
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:43098/commands.html" />
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:43098/taskpane.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GetStarted.Title" DefaultValue="Bienvenue sur PieceMaker!" />
        <bt:String id="CommandsGroup.Label" DefaultValue="PieceMaker" />
        <bt:String id="TaskpaneButton.Label" DefaultValue="Ouvrir PieceMaker" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GetStarted.Description" DefaultValue="Votre assistant juridique intelligent est prêt à vous aider." />
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Cliquez pour ouvrir l'assistant PieceMaker" />
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>

</OfficeApp>
