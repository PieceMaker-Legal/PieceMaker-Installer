{
  "mcpServers": {
    "legifrance": {
      "command": "${PYTHON_PATH:-python3}",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp/legifrance/mcp_stdio_server.py"],
      "env": {
        "LEGIFRANCE_CLIENT_ID": "${LEGIFRANCE_CLIENT_ID:-}",
        "LEGIFRANCE_CLIENT_SECRET": "${LEGIFRANCE_CLIENT_SECRET:-}",
        "LEGIFRANCE_ENV": "${LEGIFRANCE_ENV:-production}"
      }
    }
  }
}
